DirectoryIndex index.html

AddType image/x-icon .ico
AddType image/png .png
AddType application/manifest+json .webmanifest
AddType application/xml .xml

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Один адрес сайта — как в canonical и sitemap (без www)
  RewriteCond %{HTTP_HOST} ^www\.spaexpert-em\.ru$ [NC]
  RewriteRule ^ https://spaexpert-em.ru%{REQUEST_URI} [R=301,L]

  # Главная без index.html в адресе
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # «О мастере» — это главная
  RewriteRule ^about\.html$ / [R=301,L]
</IfModule>
